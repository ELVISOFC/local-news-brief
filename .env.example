# AreaNews — environment variables
# This MVP runs fully on the frontend with mock data and the browser's
# SpeechSynthesis API. To wire up real services, add the keys below and
# replace the integration points marked in src/lib/mockData.ts and src/lib/speech.ts.

# News aggregation (pick one)
NEWS_API_KEY=
GNEWS_API_KEY=
BING_NEWS_API_KEY=

# Summarization
OPENAI_API_KEY=
# or
ANTHROPIC_API_KEY=

# Text-to-speech (pick one)
ELEVENLABS_API_KEY=
PLAYHT_API_KEY=
# OPENAI_API_KEY (above) also covers OpenAI TTS

# Audio hosting (briefings as MP3)
S3_BUCKET=
S3_REGION=
